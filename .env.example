PORT=3000

JWT_SECRET=doi_thanh_chuoi_bi_mat_that_ngau_nhien_va_dai_o_day

# ============================================
# DATABASE — chọn 1 trong 2 cách bên dưới
# ============================================

# Cách 1: Dùng database cloud (Neon, Supabase, Render, Railway...)
# Copy connection string nhà cung cấp đưa cho bạn, dạng:
# postgresql://user:password@host:5432/dbname?sslmode=require
# DATABASE_URL=
# DB_SSL=true

# Cách 2: PostgreSQL chạy local trên máy — dùng các biến riêng lẻ bên dưới
DB_USER=postgres
DB_HOST=localhost
DB_NAME=userdb
DB_PASSWORD=doi_thanh_mat_khau_that_o_day
DB_PORT=5432
DB_SSL=false

# Danh sách domain được phép gọi API, phân cách bởi dấu phẩy.
# Để trống sẽ mặc định chỉ cho phép http://localhost:PORT
ALLOWED_ORIGINS=http://localhost:3000

# Đặt "production" khi deploy thật (bắt buộc cookie chỉ gửi qua HTTPS)
NODE_ENV=development
